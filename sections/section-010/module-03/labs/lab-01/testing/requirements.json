{
  "context": "kind-astro-ats-001-lab-010-03-01",
  "resources": [
    {
      "kind": "deployment",
      "name": "probe",
      "expected": {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "metadata": {
          "name": "probe",
          "namespace": "starfleet"
        },
        "spec": {
          "replicas": 3,
          "selector": {
            "matchLabels": {
              "app": "probe",
              "release": "probe"
            }
          },
          "template": {
            "metadata": {
              "labels": {
                "app": "probe",
                "release": "probe",
                "track": "shared"
              }
            },
            "spec": {
              "containers": [
                {
                  "name": "probe",
                  "image": "docker.io/library/python:3.13-alpine",
                  "command": [
                    "python",
                    "/app/server.py"
                  ],
                  "env": [
                    {
                      "name": "VERSION",
                      "value": "v1"
                    }
                  ],
                  "ports": [
                    {
                      "name": "http",
                      "containerPort": 8080
                    }
                  ],
                  "readinessProbe": {
                    "httpGet": {
                      "path": "/ready",
                      "port": "http"
                    },
                    "periodSeconds": 2
                  },
                  "resources": {
                    "requests": {
                      "cpu": "10m",
                      "memory": "32Mi"
                    },
                    "limits": {
                      "memory": "128Mi"
                    }
                  },
                  "volumeMounts": [
                    {
                      "name": "app",
                      "mountPath": "/app",
                      "readOnly": true
                    }
                  ]
                }
              ],
              "volumes": [
                {
                  "name": "app",
                  "configMap": {
                    "name": "probe-code"
                  }
                }
              ]
            }
          }
        }
      },
      "state": "deployment"
    },
    {
